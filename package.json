{
  "name": "rocket-draft",
  "version": "1.4.4",
  "private": true,
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4",
    "ios_saf >= 16.4"
  ],
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run validate:data && npm run test:contract && npm run build:images",
    "build": "next build",
    "postbuild": "node scripts/postexport.mjs",
    "start": "npm run preview:static",
    "build:images": "node scripts/build-images.mjs",
    "preview:static": "wrangler dev",
    "predeploy": "node scripts/check-deploy.mjs",
    "deploy": "npm run build && wrangler deploy",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:data": "node scripts/build-dataset.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "validate:data": "vitest run src/data",
    "test:contract": "vitest run src/store/persistContract.test.ts",
    "fetch:assets": "node scripts/fetch-assets.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "geist": "^1.7.2",
    "next": "16.2.9",
    "posthog-js": "^1.389.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8",
    "wrangler": "^4.147.0"
  }
}
