# Cloudflare Workers Static Assets response headers (copied to out/_headers by
# `next build`; parsed by Cloudflare, never served itself).
# Syntax: https://developers.cloudflare.com/workers/static-assets/headers/
# - Every rule that matches a path applies; a header set by two rules has its
#   values comma-joined. So Cache-Control is set ONLY in path-specific rules,
#   never under /*.
# - HTML pages and *.txt RSC payloads have no rule on purpose: they keep the
#   host default (public, max-age=0, must-revalidate + ETag), so a deploy is
#   visible on the next load and always matches its hashed chunks.
# - Limit: 100 rules.

# Content-hashed by Next (JS, CSS, fonts) or by scripts/build-images.mjs
# (WebP variants): a changed file always gets a new URL.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=31536000, immutable

# Not hashed (stable names in public/) — moderate TTLs.
/flags/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/orgs/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/cards/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/ranks/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/badges/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# 30 days (PageSpeed flagged the 7-day TTL as a short cache lifetime). Not a
# year: the header logo and the web manifest request /icon.svg bare, with no
# content hash, so a new icon must still reach returning players in weeks.
/icon.svg
  Cache-Control: public, max-age=2592000

/favicon.ico
  Cache-Control: public, max-age=604800

/apple-icon.png
  Cache-Control: public, max-age=2592000

/opengraph-image.png
  Cache-Control: public, max-age=604800

/manifest.webmanifest
  Cache-Control: public, max-age=86400

# Security headers for every response (no Cache-Control here — see above).
# v2.0 (PageSpeed "Best practices"):
# - HSTS: the whole .app TLD is on the browsers' HSTS preload list, so HTTPS is
#   already forced; the header states it for clients that read it.
# - Framing: only the site itself may frame its pages (clickjacking). Both
#   forms, for old and new browsers.
# - COOP same-origin-allow-popups isolates the window from pages that open it,
#   and still lets the site open pop-ups (the Discord / Ko-fi links).
# - The CSP is deliberately partial: no script-src. A static export has inline
#   bootstrap scripts and cannot use nonces, so a script policy would need
#   'unsafe-inline' and protect nothing; PageSpeed keeps listing that item.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: SAMEORIGIN
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy: frame-ancestors 'self'; base-uri 'self'; object-src 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
